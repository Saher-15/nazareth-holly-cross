{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "description": "Nazareth Holy Cross - secure admin dashboard (Next.js, BFF over the admin API)",
  "scripts": {
    "dev": "next dev -p 3901",
    "dev:mock": "node mock-api/server.mjs",
    "build": "next build",
    "start": "next start -p 3901",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e:harness": "node scripts/e2e.mjs harness",
    "dev:harness": "node ../server/test-harness/serve.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "jsqr": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
