# Copy to .env.local (never commit it). Everything here is read on the server except NEXT_PUBLIC_*.

# Origin of the admin API (server/). The browser never talks to it: the Next.js route handlers do.
# Local mock of the contract:  npm run dev:mock  ->  http://localhost:3902
ADMIN_API_URL=http://localhost:3902

# Extra origins allowed to send state-changing requests to this app (comma list). Default: only its own origin.
ADMIN_ALLOWED_ORIGINS=

# Time zone used to print dates (an IANA name).
ADMIN_TIMEZONE=Asia/Jerusalem

# Extra https image hosts allowed in the Content-Security-Policy img-src (comma list of origins).
# firebasestorage.googleapis.com is always allowed (product photos).
ADMIN_IMG_SRC=

# Firebase Storage (product photo upload). Public values of the web app, not secrets, but still not committed.
# Leave empty to disable upload: the product form then asks for pasted image URLs.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
