DATABASEURL=mongodb+srv://username:password@cluster.mongodb.net/dbname
PORT=5000
NODE_ENV=development
# At least 32 random characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
# The server refuses to start in production with the example value, or with the same value as ADMIN_PASSWORD.
JWT_SECRET=your-very-long-random-secret-key-here
# At least 12 characters. The shared password for POST /auth/login.
ADMIN_PASSWORD=your-secure-admin-password
# Optional: comma-separated extra browser origins allowed by CORS (e.g. a new admin domain).
# EXTRA_ORIGINS=https://admin.example.com
# Browser origins of the NEW admin dashboard (exact origins, comma-separated, no wildcards). See docs/ADMIN.md.
# ADMIN_ORIGINS=https://admin.nazarethholycross.com
# Optional: "true" makes /order/newOrder and /candle/lightACandle require a PayPal-verified payment (see docs/SECURITY.md).
# REQUIRE_PAYMENT_PROOF=false
# Optional: "true" makes the server build its database indexes at start-up even in production (development always does).
# Leave it unset in production: run `node scripts/ensure-indexes.js --apply` instead (docs/DATABASE.md section 5).
# AUTO_INDEX=false
CLIENT_URL=http://localhost:3000
ENVIRONMENT=sandbox
MAIL_FROM=your-email@gmail.com
MAIL_APP_PASSWORD=your-gmail-app-password
CLIENT_ID=paypal-rest-client-id
CLIENT_SECRET=paypal-rest-client-secret
