# Editor settings shared by everyone (VS Code needs the "EditorConfig for VS Code" extension; most other editors read it).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces mean a line break in Markdown
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,webp,avif,ico,mp3,mp4,webm,woff,woff2}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
