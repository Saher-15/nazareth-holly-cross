rules_version = '2';
// Nazareth Holy Cross: product photos and videos (docs/INFRASTRUCTURE.md 6.2, docs/SECURITY.md).
// Anyone may read a file by its address (the site shows them); nobody may list the bucket.
// The admin dashboard uploads product photos WITHOUT signing in (admin/src/lib/firebase-upload.ts), so the only
// anonymous write allowed is creating a NEW image under images/<folder>/<file>: an image type, under 8 MB.
// Nothing can be overwritten or deleted through the API; the Firebase console (which ignores these rules) still can.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }
    match /images/{folder}/{file} {
      allow create: if request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)');
    }
  }
}
