{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --require ../ops/braces-depth-guard.cjs node_modules/eslint/bin/eslint.js .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "media:build": "node scripts/media/build.mjs",
    "media:verify": "node scripts/media/build.mjs --verify",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "security:audit": "node ../ops/audit-dependencies.mjs"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.5.2",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "intl-messageformat": "^12.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
